# From Supabase Project Settings -> API. The anon/publishable key is safe to
# ship in the browser bundle — never put the service_role/secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key_here

# Deployed Edge Function URL from `supabase functions deploy`.
VITE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/recommendation
