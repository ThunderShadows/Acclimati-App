# Project URL, from Supabase Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role / secret key — NEVER the anon/publishable key, and never commit
# the real value. Needed because `cities` has RLS with no public policy: only
# the service role can write to it. Get it from Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
